# Marais profile environment.
#
# In practice the installer symlinks the profile's .env to your global
# ~/.hermes/.env, which already holds these values. This file documents what
# the profile needs if you ever set it up standalone.

# MiniMax model provider (required — the profile's default model).
MINIMAX_API_KEY=

# Langfuse tracing, read by the observability/langfuse plugin.
HERMES_LANGFUSE_PUBLIC_KEY=
HERMES_LANGFUSE_SECRET_KEY=
HERMES_LANGFUSE_BASE_URL=http://localhost:3000
HERMES_LANGFUSE_ENV=production
